# Copie para .env antes de rodar:  cp .env.docker.example .env
# O Compose lê este arquivo automaticamente — nada de credencial no código.

# --- Porta da página no host ---
FRONTEND_PORT=8080

# --- PostgreSQL (contêiner db) ---
POSTGRES_USER=certificado
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=certificado

# --- Blockchain / relayer ---
# Conta #0 padrão do nó Hardhat (pública e conhecida — SOMENTE para o nó
# local de desenvolvimento; NUNCA use esta chave em rede real).
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Sal do ID anônimo dos alunos: keccak256(SAL + ":" + RA).
# Mantenha em segredo e NUNCA troque no meio de um curso.
SAL_ALUNOS=troque-por-um-segredo-longo-e-aleatorio
