PRIVATE_KEY=0xsua_chave_privada_de_TESTE_aqui
ETHERSCAN_API_KEY=sua_api_key_aqui

# --- Operação (preencher após o deploy) ---
CONTRATO=0xendereco_do_contrato_apos_deploy

# Sal usado para gerar o ID anônimo dos alunos: keccak256(SAL + ":" + RA).
# Mantenha em segredo e NUNCA troque no meio de um curso.
SAL_ALUNOS=troque-por-um-segredo-longo-e-aleatorio
